# Copy to ~/.hermes/profiles/orchestrator/.env (never commit the real file).
# `orchestrator gateway setup` can fill these in interactively.

DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=          # comma-separated Discord user IDs

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=         # comma-separated Telegram user IDs

# Optional: calendar access for the secretary (Google Workspace skill).
# The OAuth client secret JSON lives in ~/.hermes, never in this repo.
